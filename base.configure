#!/bin/bash

# Determine source type (tag or PR).
if [ "$1" == "--tag" ]; then
  GH_CONFIG_SRC="tag"
  GH_CONFIG_SRC_DESC="TAG NAME"
  GH_COMMIT_ID="$GITHUB_SHA"

  export PUSHED_TAG="${2##*/}"
  echo "~> CONFIG MODE: $GH_CONFIG_SRC"
  echo "~> TAG: $PUSHED_TAG"
  ARTIFACT_VERSION="${PUSHED_TAG:1:((${#PUSHED_TAG}-1))}"
  mapfile -t PARSED < <(.github/github-tools/artifact.version.parse "$ARTIFACT_VERSION")
  GH_PR_TITLE="(n/a)"
  GH_PR_NUMBER="${PARSED[4]}"
  echo "~> GH_PR_TITLE: $GH_PR_TITLE"
  echo "~> GH_PR_NUMBER: $GH_PR_NUMBER"
else
  GH_CONFIG_SRC="pr"
  GH_CONFIG_SRC_DESC="PR TITLE"
  GH_COMMIT_ID="$GITHUB_EVENT_PULL_REQUEST_HEAD_SHA"

  if [ -z "$1" ]; then
    GH_CONFIG_SRC_DESC+=" (FETCHED)"
    IFS=$'\n' read -d '' -r GH_PR_TITLE GH_PR_NUMBER < <(gh.pr.get-by-commit) || true
  else
    GH_PR_TITLE="$1"
    GH_PR_NUMBER="$2"
  fi

  echo "~> INFO FROM: $GH_CONFIG_SRC_DESC"
  echo "~> GH_PR_TITLE: $GH_PR_TITLE"
  echo "~> GH_PR_NUMBER: $GH_PR_NUMBER"

  PRJ_VERSION="$(.github/github-tools/prj.version.determine)"
  echo "~> Version on POM: $PRJ_VERSION"

  ARTIFACT_VERSION="$(.github/github-tools/artifact.version.generate "$PRJ_VERSION" "$GH_PR_TITLE" "$GH_PR_NUMBER")"
fi

echo "~> GITHUB_SHA: $GITHUB_SHA"

# Check if it was possible to determine the artifact version
[ -z "$ARTIFACT_VERSION" ] && {
    echo "::error::Unable to determine the artifact version, please check the ${GH_CONFIG_SRC_DESC}"
    exit 99
}

# Determine publication type (snapshot or release).
if [[ "$ARTIFACT_VERSION" = *"-PR"* ]]; then
  ARTIFACT_PUB_TYPE="snapshot"
else
  ARTIFACT_PUB_TYPE="release"
fi

# Get PR labels.
GH_PR_LABELS=$(gh pr view "$GH_PR_NUMBER" --json labels --jq '.labels | map(.name) | join(",")' | tr -d '"')
SKIP_TESTS=false;

# Check for skip-tests label.
if [[ ",$GH_PR_LABELS," == *",skip-tests,"* ]]; then
  SKIP_TESTS=true
fi

# Check for skip-scans label.
SKIP_SCANS=false;
if [[ ",$GH_PR_LABELS," == *",skip-scans,"* ]]; then
  SKIP_SCANS=true
fi

# Check for verbose label.
VERBOSE=false
if [[ ",$GH_PR_LABELS," == *",verbose,"* ]]; then
  VERBOSE=true
  echo ""
  echo "~> PR INFO:"
  gh pr list --json number,title,headRefName,updatedAt
fi

echo ""

# Exports a set of variables (see {configure.complete})
CONFIGURED_VARS+=("PRJ_VERSION" "ARTIFACT_VERSION" "ARTIFACT_PUB_TYPE" "SKIP_TESTS" "SKIP_SCANS" "GH_PR_LABELS" "VERBOSE" "GH_CONFIG_SRC" "GH_PR_TITLE" "GH_PR_NUMBER" "GH_COMMIT_ID")
