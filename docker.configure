#!/bin/bash

case "$ARTIFACT_PUB_TYPE" in
  snapshot)
    [ -n "${DOCKER_ORG_SNAPSHOT:-}" ] && DOCKER_ORG="$DOCKER_ORG_SNAPSHOT"
    [ -n "${DOCKER_REGISTRY_SNAPSHOT:-}" ] && DOCKER_REGISTRY="$DOCKER_REGISTRY_SNAPSHOT"
    [ -n "${DOCKER_USERNAME_SNAPSHOT:-}" ] && DOCKER_USERNAME="$DOCKER_USERNAME_SNAPSHOT"
    [ -n "${DOCKER_PASSWORD_SNAPSHOT:-}" ] && DOCKER_PASSWORD="$DOCKER_PASSWORD_SNAPSHOT"
  ;;
  release)
    [ -n "${DOCKER_ORG_RELEASE:-}" ] && DOCKER_ORG="$DOCKER_ORG_RELEASE"
    [ -n "${DOCKER_REGISTRY_RELEASE:-}" ] && DOCKER_REGISTRY="$DOCKER_REGISTRY_RELEASE"
    [ -n "${DOCKER_USERNAME_RELEASE:-}" ] && DOCKER_USERNAME="$DOCKER_USERNAME_RELEASE"
    [ -n "${DOCKER_PASSWORD_RELEASE:-}" ] && DOCKER_PASSWORD="$DOCKER_PASSWORD_RELEASE"
  ;;
esac

CONFIGURED_VARS+=("DOCKER_ORG" "DOCKER_REGISTRY" "DOCKER_USERNAME" "DOCKER_PASSWORD")
